# Opens a shell in the specified Scholastica environment.
# Usage: scholastica-shell [local|staging|demo|production|<pr-number>]
# Defaults to local if no argument is provided.
scholastica-shell() {
  local env="${1:-local}"

  case "$env" in
    local)
      # Attach to the existing container if one is already bound to port 3000,
      # otherwise spin up a fresh one.
      if docker container ls | grep -q '3000'; then
        echo "attaching to existing container"
        local container_id
        container_id=$(docker ps --filter "publish=3000" --format "{{.ID}}")
        docker exec -it "$container_id" bash
      else
        echo "creating a new container"
        docker compose run --remove-orphans --rm --service-ports web bash
      fi
      ;;
    production)
      # Production app name doesn't follow the scholastica-$env pattern.
      heroku run bash --app scholastica --size=performance-l
      ;;
    staging|demo)
      heroku run bash --app "scholastica-$env" --size=performance-l
      ;;
    <->)
      # Numeric argument is treated as a PR number.
      heroku run bash --app "scholastica-staging-pr-$env" --size=performance-l
      ;;
    *)
      echo "Usage: scholastica-shell [local|staging|demo|production|<pr-number>]" >&2
      return 1
      ;;
  esac
}

# Completion function for scholastica-shell.
# Registered via compdef below — requires compinit to have been run.
_scholastica_shell_completions() {
  local envs=('local' 'staging' 'demo' 'production')
  compadd "$@" -- "${envs[@]}"
}

compdef _scholastica_shell_completions scholastica-shell

scholastica-production-shell() {
  scholastica-shell production
}

scholastica-staging-shell() {
