# Opens a Rails console in the specified Scholastica environment.
# Usage: scholastica-console [local|staging|demo|production|<pr-number>]
# Defaults to local if no argument is provided.
scholastica-console() {
  local env="${1:-local}"

  case "$env" in
    local)
      # Attach to the existing container if one is already bound to port 3000,
      # otherwise spin up a fresh one.
      if docker container ls | grep -q '3000'; then
        echo "attaching to existing container"
        local container_id
        container_id=$(docker ps --filter "publish=3000" --format "{{.ID}}")
        docker exec -it "$container_id" bundle exec rails console
      else
        echo "creating a new container"
        docker compose run --remove-orphans --rm --service-ports web rails console
      fi
      ;;
    production)
      # Production app name doesn't follow the scholastica-$env pattern.
      heroku run bundle exec rails console --app scholastica --size=performance-l
      ;;
    staging|demo)
      heroku run bundle exec rails console --app "scholastica-$env" --size=performance-l
      ;;
    <->)
      # Numeric argument is treated as a PR number.
      heroku run bundle exec rails console --app "scholastica-staging-pr-$env" --size=performance-l
      ;;
    *)
      echo "Usage: scholastica-console [local|staging|demo|production|<pr-number>]" >&2
      return 1
      ;;
  esac
}

_scholastica_console_completions() {
  local envs=('local' 'staging' 'demo' 'production')
  compadd "$@" -- "${envs[@]}"
}

compdef _scholastica_console_completions scholastica-console





scholastica-lint() {
  scholastica-lint-js && scholastica-lint-rb
}

scholastica-lint-js() {
    cd modules/scholastica-tools && \
    npm run lint:fix &&
    cd -
}

scholastica-watch() {
  local PROJECT="$1"

  if [ -z "$PROJECT" ]; then
    echo "Usage: scholastica-watch <project_name>"
    return 1
  fi

  local PROJECT_DIR="/Users/tatum/Code/scholastica/scholastica/modules/scholastica-tools"

  if [ ! -d "$PROJECT_DIR" ]; then
    echo "Project directory does not exist: $PROJECT_DIR"
    return 1
  fi

  (cd "$PROJECT_DIR" && ng run "$PROJECT":build:development --watch)
}

scholastica-lint-rb() {
  echo "running: bundle exec standardrb --fix..."
  standardrb --fix
}
