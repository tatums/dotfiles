#!/usr/bin/env bash
set -euo pipefail

dir="$HOME/dotfiles"
olddir="$HOME/dotfiles_old"

files=(
  digrc
  gemrc
  gitconfig
  gitignore
  shell_aliases
  tmux.conf
  zshenv
  zprofile
  zshrc
)

echo "-- Creating $olddir for backup of any existing dotfiles"
mkdir -p "$olddir"

echo "-- Changing to the $dir directory"
cd "$dir"

for file in "${files[@]}"; do
  src="$dir/$file"
  dest="$HOME/.$file"

  echo "---- Processing .$file"

  # Backup existing file if it exists and is not the correct symlink
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    echo "------ Backing up existing .$file to $olddir"
    mv "$dest" "$olddir/"
  fi

  # Create or update symlink
  echo "------ Linking $src → $dest"
  ln -snf "$src" "$dest"
done

# Config files that live under ~/.config rather than directly in $HOME.
config_files=(
  ghostty/config.ghostty
)

for file in "${config_files[@]}"; do
  src="$dir/$file"
  dest="$HOME/.config/$file"
  backup="$olddir/.config/$file"

  echo "---- Processing .config/$file"
  mkdir -p "$(dirname "$dest")"

  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    echo "------ Backing up existing .config/$file to $backup"
    mkdir -p "$(dirname "$backup")"
    mv "$dest" "$backup"
  fi

  echo "------ Linking $src → $dest"
  ln -snf "$src" "$dest"
done
